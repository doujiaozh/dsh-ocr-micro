{
  "compilerOptions": {
    "target": "ES2019",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2019"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "importHelpers": false
  },
  "include": [
    "cv_preprocess/src/**/*.ts",
    "ocr_infer/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "benchmark",
    "model_forge"
  ]
}
